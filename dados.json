stico.base": true, "diagnostico.concorrente": true, "diagnostico.funil": true, "diagnostico.gargalo": true, "diagnostico.organico": true, "onboarding.ficha": true, "onboarding.kickoff": true, "proposta.aceite": true, "proposta.ajuste": true, "proposta.deck": true, "proposta.objecoes": true, "proposta.reuniao": true, "radar.conversa": true, "radar.origem": true, "radar.perfil": true, "radar.produtos": true, "viabilidade.cenarios": true, "viabilidade.linha": true, "viabilidade.modelo": true, "viabilidade.vai": true}, "criadoEm": "2026-10-08T12:00:00.000Z", "dataCarrinho": "2026-11-05", "estrategia": ["O gargalo da Black é acesso, não copy nem criativo: sem o link do grupo e a conta de anúncios, a captação de 13 dias (20/10 a 01/11) perde um dia por dia parado.", "Para a base de 631 alunas, a oferta é upgrade para o anual, não desconto em quem já ia renovar.", "Antes do carrinho, fechar no papel: quem recebe, split 60/40 e verba."], "etapa": "onboarding", "faturamento": 25000, "fit": {"audiencia": 4, "comercial": 1, "engajamento": 4, "investe": 2, "produto": 3}, "foto": "data:image/jpeg;base64,", "handle": "@jessicacristiannii", "historico": [{"em": "2026-10-08T12:00:00.000Z", "txt": "Entrou no Radar pela Greenn Partners"}, {"em": "2026-10-12T12:00:00.000Z", "txt": "Raio-X: orgânico, comparativos com Aline Pamplona e cenários 60/40"}, {"em": "2026-10-12T18:00:00.000Z", "txt": "Viabilidade: recomendação de piloto de 90 dias antes da sociedade"}, {"em": "2026-10-14T12:00:00.000Z", "txt": "Primeira reunião feita. Parceria fechada: 60/40 com teste de 90 dias"}, {"em": "2026-10-14T19:40:00.000Z", "txt": "Moveu para Onboarding com o contrato pendente: assinatura, quem recebe e split"}, {"em": "2026-10-14T19:41:00.000Z", "txt": "Próxima ação: reunião de onboarding em 15/10"}, {"em": "2026-10-14T20:30:00.000Z", "txt": "Plano trocado para o lançamento meteórico em grupos (cronograma da Natália), com carrinho em 27/11 e 25 itens acrescentados"}, {"em": "2026-10-15T10:20:00.000Z", "txt": "Onboarding feito (call gravada, 1h20). A Black mudou: tráfego de 20/10 a 01/11, 4 lives de 02 a 05/11 e carrinho de 05 a 08/11, antes da Black da Joia em 09/11"}, {"em": "2026-10-15T20:00:00.000Z", "txt": "Copy pronta: dossiê, página de captura, 5 anúncios de topo (A1 a A5), mensagens do grupo e página da Black. Oferta sem desconto: semestral R$297 e anual R$397 (13 meses), aguardando aprovação dela"}, {"em": "2026-10-19T18:00:00.000Z", "txt": "Carrossel orgânico da Black refeito (v2, 4 slides) e vídeo curto da Black SSD. Bike virou concurso cultural sem compra, falta aprovação e regulamento"}, {"em": "2026-10-20T18:00:00.000Z", "txt": "Página de captura no ar em blackssd.jessicacristianni.com.br, com GTM e evento lead_black_ssd. Falta o link do grupo de WhatsApp"}, {"em": "2026-10-21T18:00:00.000Z", "txt": "Checkouts da página do SSD trocados para a conta Greenn 198650 (semestral, anual e mensal)"}, {"em": "2026-10-22T12:00:00.000Z", "txt": "Tráfego atrasado: era para começar em 20/10 e ainda falta o link do grupo na página e a conta de anúncios conectada"}], "inicioTeste": "2026-10-15", "meta": 100000, "modelo": "Sociedade 60/40 + teste 90 dias", "nicho": "Fitness feminino", "nome": "Jéssica Cristianni", "notas": "Parceria fechada em 14/10: 60% Jéssica / 40% nós (você + Natália) sobre o lucro líquido, com teste de 90 dias. Ainda falta pôr no papel: quem recebe (checkout da Greenn mostra INTEGRAQUALI), split e marcos do teste. 631 alunas ativas, ~90% de renovação com a renovação automática desligada. Nunca rodou tráfego. Produtos na Greenn: SSD R$97/mês, semestral R$297, anual R$397, Desafio R$97; consultoria R$300–480 na Prime Coaching. Black Friday em 27/11. Proposta da Natália (out/2026, proposta/2026-10-proposta-coproducao-natalia.pdf): piloto de 90 dias de novembro a janeiro; custos pagos pelo caixa da operação e divididos 60/40; reserva de 10% a 15% do lucro líquido antes da divisão; oferta da Black = anual do SSD com bônus (HIIT Tabata, Fire 21, planos alimentares, fichas); ascensão para a consultoria.", "origem": "Greenn Partners (curadoria de 08/10)", "pasta": "Documents/Clientes/Jessica Cristianni", "perfil": {"fonte": "Instagram em 14/10/2026 e análise de 120 posts feita em 12/10/2026", "leitura": "Público engajado e fiel, mas com pouco alcance novo e sem captura. Ela posta menos da metade da Aline e não tem quiz, direct nem comercial no WhatsApp, e o ticket é baixo (R$ 97/mês). O piloto precisa atacar volume de conteúdo, captura e uma oferta de ticket maior, como a consultoria. A renovação automática desligada é dinheiro parado na mesa.", "metricas": [{"rotulo": "Seguidores no Instagram", "valor": "918 mil"}, {"rotulo": "Seguidores no TikTok (@treinadorajessica)", "valor": "1,03 mi"}, {"comparacao": "Aline: 3,2", "rotulo": "Posts por dia", "valor": "1,4"}, {"comparacao": "Aline: 152 mil", "rotulo": "Visualizações por Reel (mediana)", "valor": "54,5 mil"}, {"comparacao": "Aline: 23,3 mi", "rotulo": "Visualizações de Reels por mês", "valor": "1,8 mi"}, {"comparacao": "Aline: 0,10%", "rotulo": "Engajamento", "valor": "0,16%"}, {"rotulo": "Curtidas por post (mediana)", "valor": "1.400"}, {"rotulo": "Comentários por post (mediana)", "valor": "33"}, {"comparacao": "~90% renovam", "rotulo": "Alunas ativas", "valor": "631"}, {"rotulo": "Faturamento estimado hoje", "valor": "R$ 25 mil/mês"}], "relatorios": ["analise/2026-10-12-analise-parceria.pdf", "analise/2026-10-12-comparativo-organico.pdf", "analise/2026-10-12-comparativo-proporcional.pdf", "analise/2026-10-12-comparativo-aline-pamplona.pdf", "analise/2026-10-12-viabilidade-sociedade-60-40.pdf", "analise/2026-10-12-decisao-piloto-90-dias.pdf"]}, "plano": {"aquec.conteudo": "fazendo", "estrut.captura": "fazendo", "estrut.criativos": "fazendo", "estrut.oferta": "fazendo", "estrut.pagina": "fazendo", "estrut.pixel": "fazendo", "estrut.preco": "fazendo", "estrut.roteiro": "fazendo", "prep.acessos": "fazendo", "prep.contrato": "fazendo", "prep.ssd": "fazendo"}, "planoModelo": "meteorico", "planoNota": "Atualizado em 22/10. Na call de 15/10 a Black foi antecipada: captação com tráfego de 20/10 a 01/11, 4 lives de 02 a 05/11 e carrinho de 05 a 08/11 (fecha antes da Black da Joia em 09/11). A data do carrinho no painel virou 05/11, então as fases se recalculam a partir dela. Já está em andamento: copy completa da captação e da página da Black, página de captura no ar (blackssd.jessicacristianni.com.br) com GTM e evento de Lead, checkouts do SSD na conta Greenn 198650, carrossel v2 e vídeo curto da Black. Travas: link do grupo vazio na página, conta de anúncios não conectada, contrato não assinado, quem recebe não confirmado, verba não definida e a oferta ainda sem aprovação dela (bônus, garantia de 15 dias e bike como concurso cultural). Leitura: cada dia sem tráfego tira um dia de uma captação que já era de só 13 dias. O gargalo hoje não é copy nem criativo, é acesso. Vale cobrar os dois acessos antes de produzir mais peça.", "proximaAcao": "Destravar o tráfego hoje: link do grupo de WhatsApp na página de captura e acesso à conta de anúncios. Em seguida, contrato assinado, quem recebe e verba", "proximaData": "2026-10-22", "responsavel": "Você + Natália", "seguidores": 918000, "status": "ativo", "trafego": {"campanhas": [], "chip": "Tráfego sem acesso", "contas": [], "faturamento": null, "fonte": "Sem conta de anúncios conectada em 22/10", "investido": null, "leitura": "Nunca rodou tráfego antes da parceria. O Jairo escreveu os roteiros dos anúncios e a página VIP está no ar com o pixel dela, mas sem acesso à conta não dá para dizer se algum anúncio está rodando nem quanto custou o lead.", "pendencias": [], "periodo": "Black: captação de 20/10 a 01/11/2026", "resumo": [{"comparacao": "conta não conectada", "rotulo": "Investido", "valor": "sem leitura"}, {"comparacao": "caixa dividido 60/40", "rotulo": "Verba da Black", "valor": "a definir"}, {"alerta": true, "comparacao": "20/10 a 01/11", "rotulo": "Captação planejada", "valo